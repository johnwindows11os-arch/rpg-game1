class Shop:
    W, H = 450, 320

    def __init__(self, rect):
        self.rect = rect
        self.open = False
        self.linked_npc: Optional[NPC] = None

    def draw_world(self, s):
        pygame.draw.rect(s,(200,150,50),self.rect)
        s.blit(font.render("SHOP",True,(0,0,0)),(self.rect.x+8,self.rect.y+30))
        if not self.open:
            s.blit(sml_font.render("Click Sign",True,(255,240,180)),(self.rect.x-10,self.rect.y+55))

    def world_click(self, mouse_pos, player_rect, current_map):
        dist = math.hypot(player_rect.centerx-self.rect.centerx, player_rect.centery-self.rect.centery)
        if dist < 120 and self.rect.collidepoint(mouse_pos):
            # Bind the shop context to the closest shopping NPC present on the map
            shop_npcs = [n for n in current_map.npcs if n.npc_type in ["Merchant", "Blacksmith", "Alchemist"]]
            if shop_npcs:
                self.linked_npc = shop_npcs[0]
                self.open = True
                return True
        return False

    def _panel_rect(self):
        return pygame.Rect(WIDTH//2-self.W//2, HEIGHT//2-self.H//2, self.W, self.H)

    def _item_btn(self, panel, i):
        return pygame.Rect(panel.x+20, panel.y+70+i*46, self.W-40, 38)

    def _reroll_btn(self, panel):
        return pygame.Rect(panel.x+20, panel.bottom-48, 160, 32)

    def _close_btn(self, panel):
        return pygame.Rect(panel.right-110, panel.y+10, 90, 28)

    def draw_panel(self, s, player, mouse_pos):
        if not self.open or not self.linked_npc: return
        panel = self._panel_rect()
        pygame.draw.rect(s,(15,15,35),panel,border_radius=10)
        pygame.draw.rect(s,(200,150,50),panel,2,border_radius=10)
        
        s.blit(med_font.render(f"{self.linked_npc.name}'s Shop",True,(200,150,50)),(panel.x+20,panel.y+12))
        s.blit(font.render(f"Gold: {player.gold}",True,(255,215,0)),(panel.x+20,panel.y+42))

        close = self._close_btn(panel)
        draw_button(s, close, "✕ Close", close.collidepoint(mouse_pos),(80,20,20),(140,40,40))

        # Render Stock Items
        for i, item in enumerate(self.linked_npc.shop_stock):
            btn = self._item_btn(panel, i)
            can = player.gold >= item.value
            hover = btn.collidepoint(mouse_pos)
            base  = (30,50,30) if can else (40,30,30)
            hov   = (50,90,50) if can else (60,40,40)
            
            lbl_color = RARITY_COLORS.get(item.rarity, (255,255,255)) if can else (120,120,120)
            draw_button(s, btn, f"{item.name} (+{item.stat_mod}) — {item.value}g", hover, base, hov, lbl_color)

        # Render Reroll Button
        r_btn = self._reroll_btn(panel)
        r_can = player.gold >= self.linked_npc.reroll_cost
        r_base = (40,40,70) if r_can else (30,30,40)
        r_hov  = (60,60,110) if r_can else (30,30,40)
        draw_button(s, r_btn, f"Reroll ({self.linked_npc.reroll_cost}g)", r_btn.collidepoint(mouse_pos) and r_can, r_base, r_hov, (255,255,255) if r_can else (100,100,100))

    def panel_click(self, mouse_pos, player) -> Optional[str]:
        if not self.open or not self.linked_npc: return None
        panel = self._panel_rect()
        
        if self._close_btn(panel).collidepoint(mouse_pos):
            self.open = False
            return None
            
        # Handle Reroll click
        if self._reroll_btn(panel).collidepoint(mouse_pos):
            if player.gold >= self.linked_npc.reroll_cost:
                player.gold -= self.linked_npc.reroll_cost
                self.linked_npc.generate_stock()
                self.linked_npc.reroll_cost = int(self.linked_npc.reroll_cost * 1.5) # Scale price
                return "Shop stock refreshed!"
            return "Not enough gold to reroll!"

        # Handle purchase selection click
        for i, item in enumerate(self.linked_npc.shop_stock[:]):
            if self._item_btn(panel,i).collidepoint(mouse_pos):
                if player.gold < item.value:
                    return f"Need {item.value} Gold!"
                if len(player.inventory) >= player.max_inventory_slots:
                    return "Inventory is completely full!"
                
                player.gold -= item.value
                player.add_to_inventory(item)
                self.linked_npc.shop_stock.remove(item)
                return f"Bought {item.name}!"
        return None

