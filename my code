class NPC:
    def __init__(self, name, rect, dialogue, npc_type="Villager"):
        self.name=name; self.rect=rect
        self.dialogue=dialogue; self.idx=0; self.talking=False
        self.npc_type=npc_type # "Villager", "Merchant", "Blacksmith", "Alchemist"
        self.shop_stock = []
        self.reroll_cost = 20
        self.generate_stock()

    def generate_stock(self):
        self.shop_stock = []
        if self.npc_type == "Blacksmith":
            self.shop_stock = [
                Item("Common Sword", "weapon", 25, "Common", 1),
                Item("Rare Axe", "weapon", 60, "Rare", 3),
                Item("Chain Mail", "armor", 75, "Rare", 3)
            ]
        elif self.npc_type == "Merchant":
            self.shop_stock = [
                Item("Leather Vest", "armor", 20, "Common", 1),
                Item("Lucky Ring", "accessory", 120, "Rare", 2)
            ]
        elif self.npc_type == "Alchemist":
            self.shop_stock = [
                Item("Health Potion", "potion", 15, "Common", 50),
                Item("Health Potion", "potion", 15, "Common", 50)
            ]

    def interact(self): self.talking=True

    def click_advance(self, mouse_pos):
        if not self.talking: return False
        btn = self._btn_rect()
        if btn.collidepoint(mouse_pos):
            self.idx += 1
            if self.idx >= len(self.dialogue):
                self.talking=False; self.idx=0
            return True
        return False

    def _btn_rect(self):
        box = pygame.Rect(WIDTH//2-250, HEIGHT-120, 500, 90)
        return pygame.Rect(box.right-170, box.bottom-38, 160, 28)

    def draw(self, s):
        pygame.draw.rect(s,(180,120,60),self.rect)
        s.blit(font.render(self.name,True,(255,255,200)),(self.rect.x,self.rect.y-18))

    def draw_dialogue(self, s, mouse_pos):
        if not self.talking: return
        line = self.dialogue[self.idx % len(self.dialogue)]
        box = pygame.Rect(WIDTH//2-250, HEIGHT-120, 500, 90)
        pygame.draw.rect(s,(20,20,40),box,border_radius=8)
        pygame.draw.rect(s,(200,200,255),box,2,border_radius=8)
        s.blit(med_font.render(self.name,True,(200,200,255)),(box.x+10,box.y+8))
        s.blit(font.render(line,True,(255,255,255)),(box.x+10,box.y+40))
        btn = self._btn_rect()
        hover = btn.collidepoint(mouse_pos)
        lbl = "Close" if self.idx >= len(self.dialogue)-1 else "Next ›"
        draw_button(s, btn, lbl, hover)

