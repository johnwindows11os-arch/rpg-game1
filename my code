def draw_button(surface, rect, text, hover=False, color_base=(50,50,80), color_hover=(80,80,140), text_color=(255,255,255)):
    col = color_hover if hover else color_base
    pygame.draw.rect(surface, col, rect, border_radius=6)
    pygame.draw.rect(surface, (180,180,220), rect, 1, border_radius=6)
    label = font.render(text, True, text_color)
    surface.blit(label, (rect.centerx - label.get_width()//2, rect.centery - label.get_height()//2))

