@dataclass
class Item:
    name: str
    item_type: str = "weapon"  # "weapon", "armor", "accessory", "potion"
    value: int = 0
    rarity: str = "Common"
    stat_mod: int = 0
    id: int = field(default_factory=lambda: random.randint(100000, 999999))

@dataclass
class Quest:
    title: str
    goal: int
    reward_gold: int = 100
    progress: int = 0
    completed: bool = False

    def advance(self, amount: int = 1):
        if not self.completed:
            self.progress = min(self.progress + amount, self.goal)
            if self.progress >= self.goal:
                self.completed = True
                return True
        return False

