class Chest:
    def __init__(self, rect):
        self.rect=rect
        self.open=False
        self.respawn_timer = 0
        self.COOLDOWN_TICKS = 1080 # 18 seconds total at 60 FPS

    def update(self):
        if self.open:
            self.respawn_timer -= 1
            if self.respawn_timer <= 0:
                self.open = False

    def draw(self, s):
        if self.open:
            col = (90,80,70)
            pygame.draw.rect(s,col,self.rect)
            s.blit(sml_font.render(f"{self.respawn_timer//60}s",True,(140,140,140)),(self.rect.x+10,self.rect.y+15))
        else:
            col = (255,215,0)
            pygame.draw.rect(s,col,self.rect)
            s.blit(font.render("CHEST",True,(0,0,0)),(self.rect.x-2,self.rect.y+12))
            s.blit(sml_font.render("Click",True,(255,240,180)),(self.rect.x+2,self.rect.y+30))

    def try_loot(self, mouse_pos, player_rect, player):
        dist = math.hypot(player_rect.centerx-self.rect.centerx, player_rect.centery-self.rect.centery)
        if self.open or dist > 100 or not self.rect.collidepoint(mouse_pos):
            return None
        
        if len(player.inventory) >= player.max_inventory_slots:
            return "FULL"

        self.open = True
        self.respawn_timer = self.COOLDOWN_TICKS
        weights=[40,25,12,3,25,12,3,10,15]
        item = random.choices(LOOT_TABLE,weights=weights,k=1)[0]
        
        # Instantiate clean instance copy
        new_item = Item(item.name, item.item_type, item.value, item.rarity, item.stat_mod)
        player.add_to_inventory(new_item)
        return new_item

