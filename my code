class Player:
    def __init__(self):
        self.level = 1
        self.hp = 100.0
        self.max_hp = 100
        self.xp = 0
        self.gold = 0
        self.base_damage = 2
        self.base_defense = 0
        self.inventory = []
        self.max_inventory_slots = 20
        
        # Track equipment by slot
        self.equipment = {
            "weapon": None,
            "armor": None,
            "accessory": None
        }

        self.rect = pygame.Rect(300, 300+36, 28, 28)

        # Dodge roll state
        self.rolling = False
        self.roll_dx = 0.0
        self.roll_dy = 0.0
        self.roll_timer = 0
        self.roll_cooldown = 0
        self.ROLL_DURATION  = 14
        self.ROLL_COOLDOWN  = 45
        self.ROLL_SPEED     = 10
        self.INVINCIBLE_FRAMES = 12

    def xp_needed(self):        return self.level * 50
    
    @property
    def damage(self):
        bonus = self.equipment["weapon"].stat_mod if self.equipment["weapon"] else 0
        return self.base_damage + bonus

    @property
    def defense(self):
        bonus_arm = self.equipment["armor"].stat_mod if self.equipment["armor"] else 0
        bonus_acc = self.equipment["accessory"].stat_mod if self.equipment["accessory"] else 0
        return self.base_defense + bonus_arm + bonus_acc

    def is_invincible(self):    return self.rolling and self.roll_timer > (self.ROLL_DURATION - self.INVINCIBLE_FRAMES)

    def add_xp(self, amount):
        self.xp += amount
        leveled = False
        while self.xp >= self.xp_needed():
            self.xp -= self.xp_needed()
            self.level += 1
            self.max_hp += 10
            self.hp = self.max_hp
            self.base_damage += 1
            leveled = True
        return leveled

    def take_damage(self, raw: float):
        if self.is_invincible(): return
        mit = self.defense * 0.05
        self.hp = max(0, self.hp - raw * max(0.1, 1.0 - mit))

    def is_dead(self): return self.hp <= 0

    def start_roll(self, dx, dy):
        if self.roll_cooldown > 0 or self.rolling: return
        mag = math.hypot(dx, dy) or 1
        self.roll_dx = dx / mag
        self.roll_dy = dy / mag
        self.rolling = True
        self.roll_timer = self.ROLL_DURATION
        self.roll_cooldown = self.ROLL_COOLDOWN

    def update_roll(self):
        if self.roll_cooldown > 0: self.roll_cooldown -= 1
        if self.rolling:
            self.rect.x += int(self.roll_dx * self.ROLL_SPEED)
            self.rect.y += int(self.roll_dy * self.ROLL_SPEED)
            self.rect.clamp_ip(pygame.Rect(0,HUD_TOP,WIDTH,HEIGHT-HUD_TOP))
            self.roll_timer -= 1
            if self.roll_timer <= 0: self.rolling = False

    def add_to_inventory(self, item) -> bool:
        if len(self.inventory) < self.max_inventory_slots:
            self.inventory.append(item)
            return True
        return False

    def equip_item(self, item):
        slot = item.item_type
        if slot in self.equipment:
            if self.equipment[slot]:
                self.inventory.append(self.equipment[slot])
            self.equipment[slot] = item
            if item in self.inventory:
                self.inventory.remove(item)

    def unequip_item(self, slot):
        if slot in self.equipment and self.equipment[slot]:
            if len(self.inventory) < self.max_inventory_slots:
                self.inventory.append(self.equipment[slot])
                self.equipment[slot] = None
                return True
        return False

    def to_dict(self):
        # Base translation dict for save system
        eq_save = {k: (v.__dict__ if v else None) for k, v in self.equipment.items()}
        inv_save = [i.__dict__ for i in self.inventory]
        return {
            "level": self.level, "hp": self.hp, "max_hp": self.max_hp,
            "xp": self.xp, "gold": self.gold, "base_damage": self.base_damage, "base_defense": self.base_defense,
            "equipment": eq_save, "inventory": inv_save
        }

    def from_dict(self, d):
        self.level = d.get("level", 1)
        self.hp = d.get("hp", 100)
        self.max_hp = d.get("max_hp", 100)
        self.xp = d.get("xp", 0)
        self.gold = d.get("gold", 0)
        self.base_damage = d.get("base_damage", 2)
        self.base_defense = d.get("base_defense", 0)
        
        # Restore lists
        self.inventory = []
        for i_data in d.get("inventory", []):
            self.inventory.append(Item(**i_data))
            
        self.equipment = {"weapon": None, "armor": None, "accessory": None}
        for k, v_data in d.get("equipment", {}).items():
            if v_data:
                self.equipment[k] = Item(**v_data)

# ─────────────────────────────────────────────────────────────────────────────
# Attack types
# ─────────────────────────────────────────────────────────────────────────────

class AttackType:
    SLASH = "slash"
    SPIN  = "spin"
    LUNGE = "lunge"

class Attack:
    DURATIONS  = {AttackType.SLASH:10, AttackType.SPIN:14, AttackType.LUNGE:10}
    COOLDOWNS  = {AttackType.SLASH:18, AttackType.SPIN:55, AttackType.LUNGE:30}
    SLASH_DIST=70; SLASH_W=90; SLASH_H=36
    SPIN_RADIUS=72
    LUNGE_LEN=120; LUNGE_W=24

    def __init__(self, kind: str, player_center, mouse_pos, base_damage: int):
        self.kind = kind
        self.cx, self.cy = player_center
        dx = mouse_pos[0]-self.cx; dy = mouse_pos[1]-self.cy
        self.angle = math.atan2(dy, dx)
        self.life = self.DURATIONS[kind]
        self.hit_enemies: set = set()
        self.damage = base_damage
        self.knockback = {AttackType.SLASH:8, AttackType.SPIN:5, AttackType.LUNGE:14}[kind]
        self._build_hitbox()

    def _build_hitbox(self):
        if self.kind == AttackType.SLASH:
            hx = self.cx + math.cos(self.angle)*self.SLASH_DIST - self.SLASH_W//2
            hy = self.cy + math.sin(self.angle)*self.SLASH_DIST - self.SLASH_H//2
            self.hitbox = pygame.Rect(hx, hy, self.SLASH_W, self.SLASH_H)
        elif self.kind == AttackType.SPIN:
            r = self.SPIN_RADIUS
            self.hitbox = pygame.Rect(self.cx-r, self.cy-r, r*2, r*2)
        else:
            hx = self.cx + math.cos(self.angle)*(self.LUNGE_LEN//2) - self.LUNGE_W//2
            hy = self.cy + math.sin(self.angle)*(self.LUNGE_LEN//2) - self.LUNGE_W//2
            self.hitbox = pygame.Rect(hx, hy, self.LUNGE_LEN, self.LUNGE_W)

    @property
    def active(self): return self.life > 0
    @property
    def duration(self): return self.DURATIONS[self.kind]

    def update(self): self.life -= 1

    def hits(self, enemy_rect: pygame.Rect, enemy_id: int) -> bool:
        if enemy_id in self.hit_enemies: return False
        if self.kind == AttackType.SPIN:
            dist = math.hypot(enemy_rect.centerx-self.cx, enemy_rect.centery-self.cy)
            return dist <= self.SPIN_RADIUS
        return self.hitbox.colliderect(enemy_rect)

    def draw(self, surface: pygame.Surface):
        if not self.active: return
        t = self.life / self.duration

        if self.kind == AttackType.SLASH:
            self._draw_slash(surface, t)
        elif self.kind == AttackType.SPIN:
            self._draw_spin(surface, t)
        else:
            self._draw_lunge(surface, t)

    def _draw_slash(self, surface, t):
        spread = math.radians(55)
        num = 9
        for i in range(num):
            a = self.angle - spread + (i/(num-1))*spread*2
            r_in  = 18 + (1-t)*6
            r_out = 55 + t*20
            x1 = self.cx + math.cos(a)*r_in;  y1 = self.cy + math.sin(a)*r_in
            x2 = self.cx + math.cos(a)*r_out; y2 = self.cy + math.sin(a)*r_out
            b = int(200*t)
            col = (b, b, min(255,b+55))
            w = 3 if i in (0,num-1) else 2
            pygame.draw.line(surface, col, (int(x1),int(y1)), (int(x2),int(y2)), w)
        fr = int(14*t)
        if fr > 0:
            fx = int(self.cx + math.cos(self.angle)*self.SLASH_DIST)
            fy = int(self.cy + math.sin(self.angle)*self.SLASH_DIST)
            fs = pygame.Surface((fr*2,fr*2), pygame.SRCALPHA)
            fb = int(220*t)
            pygame.draw.circle(fs,(fb,fb,255,int(180*t)),(fr,fr),fr)
            surface.blit(fs,(fx-fr,fy-fr))

    def _draw_spin(self, surface, t):
        r = int(self.SPIN_RADIUS * (0.6 + 0.4*(1-t)))
        alpha = int(220*t)
        num = 18
        for i in range(num):
            a = (i/num)*math.pi*2 + (1-t)*math.pi
            x = int(self.cx + math.cos(a)*r)
            y = int(self.cy + math.sin(a)*r)
            size = 4 if i%3==0 else 2
            b = int(200*t)
            pygame.draw.circle(surface,(b,min(255,b+100),b),(x,y),size)
        ring_surf = pygame.Surface((r*2+4,r*2+4), pygame.SRCALPHA)
        pygame.draw.circle(ring_surf,(100,255,120,alpha),(r+2,r+2),r,2)
        surface.blit(ring_surf,(self.cx-r-2,self.cy-r-2))

    def _draw_lunge(self, surface, t):
        length = int(self.LUNGE_LEN * (0.5+0.5*t))
        for offset in (-6,-3,0,3,6):
            oa = self.angle + math.pi/2
            ox = math.cos(oa)*offset; oy = math.sin(oa)*offset
            x1 = int(self.cx + ox + math.cos(self.angle)*10)
            y1 = int(self.cy + oy + math.sin(self.angle)*10)
            x2 = int(self.cx + ox + math.cos(self.angle)*length)
            y2 = int(self.cy + oy + math.sin(self.angle)*length)
            b = int(220*t)
            col = (255,b,b//2)
            pygame.draw.line(surface,col,(x1,y1),(x2,y2),2 if offset!=0 else 3)
        tip_x = int(self.cx + math.cos(self.angle)*length)
        tip_y = int(self.cy + math.sin(self.angle)*length)
        fs = pygame.Surface((20,20),pygame.SRCALPHA)
        b = int(200*t)
        pygame.draw.circle(fs,(255,b,0,int(180*t)),(10,10),8)
        surface.blit(fs,(tip_x-10,tip_y-10))

