    # ── Main engine execution loop ───────────────────────────────────────────

    def run(self):
        running=True
        while running:
            clock.tick(60)
            mouse_pos=pygame.mouse.get_pos()
            lclick=False; rclick=False; space_dn=False; q_dn=False

            for ev in pygame.event.get():
                if ev.type==pygame.QUIT: running=False
                if ev.type==pygame.KEYDOWN:
                    if ev.key==pygame.K_p: self.save()
                    if ev.key==pygame.K_l: self.load()
                    if ev.key==pygame.K_q: q_dn=True
                    if ev.key==pygame.K_SPACE: space_dn=True
                    if ev.key==pygame.K_i:
                        if self.state == GS.PLAYING: self.state = GS.INVENTORY
                        elif self.state == GS.INVENTORY: self.state = GS.PLAYING
                    if ev.key==pygame.K_ESCAPE:
                        if self.shop.open: self.shop.open=False
                        elif self.state == GS.INVENTORY: self.state = GS.PLAYING
                        else: self.hud_visible = not self.hud_visible
                if ev.type==pygame.MOUSEBUTTONDOWN:
                    if ev.button==1: lclick=True
                    if ev.button==3: rclick=True

            keys=pygame.key.get_pressed()
            p=self.player

            if self.state==GS.DEAD:
                screen.fill((0,0,0))
                screen.blit(big_font.render("YOU DIED",True,(220,30,30)),(WIDTH//2-160,HEIGHT//2-60))
                screen.blit(med_font.render("P=Save  L=Load  or close",True,(200,200,200)),(WIDTH//2-200,HEIGHT//2+20))
                pygame.display.flip(); continue

            # Update Chest ticks natively
            self.chest.update()

            # ── MENU STATES PROCESSING ───────────────────────────────────────
            if self.state == GS.INVENTORY:
                if lclick:
                    self._handle_inventory_clicks(mouse_pos)
                
                # Render loop block
                self.current_map.draw(screen)
                self.shop.draw_world(screen)
                self.chest.draw(screen)
                self._draw_player()
                self._draw_inventory_screen(mouse_pos)
                self._draw_hud(mouse_pos)
                self._draw_notifications()
                pygame.display.flip()
                continue

            # ── STANDARD ACTIVE RUN STATE ────────────────────────────────────
            if not p.rolling:
                spd=5; dx=dy=0
                if keys[pygame.K_w]: dy-=spd
                if keys[pygame.K_s]: dy+=spd
                if keys[pygame.K_a]: dx-=spd
                if keys[pygame.K_d]: dx+=spd
                p.rect.x+=dx; p.rect.y+=dy
                p.rect.clamp_ip(pygame.Rect(0,HUD_TOP,WIDTH,HEIGHT-HUD_TOP))
            p.update_roll()

            if space_dn or keys[pygame.K_LSHIFT]:
                dx2=dy2=0
                if keys[pygame.K_w]: dy2-=1
                if keys[pygame.K_s]: dy2+=1
                if keys[pygame.K_a]: dx2-=1
                if keys[pygame.K_d]: dx2+=1
                if dx2==0 and dy2==0:
                    mx2=mouse_pos[0]-p.rect.centerx; my2=mouse_pos[1]-p.rect.centery
                    dx2,dy2=mx2,my2
                p.start_roll(dx2,dy2)

            npc_consumed=False
            if lclick and self.active_npc:
                if self.active_npc.click_advance(mouse_pos):
                    if not self.active_npc.talking: self.active_npc=None
                    npc_consumed=True; lclick=False

            shop_consumed=False
            if lclick and self.shop.open:
                msg=self.shop.panel_click(mouse_pos, p)
                if msg: self.notify(msg,90)
                shop_consumed=True; lclick=False
            if lclick and not shop_consumed:
                if self.shop.world_click(mouse_pos, p.rect, self.current_map):
                    shop_consumed=True; lclick=False

            if lclick and not shop_consumed and not npc_consumed:
                res=self.chest.try_loot(mouse_pos, p.rect, p)
                if res == "FULL":
                    self.notify("Inventory Full!", 90)
                    lclick = False
                elif isinstance(res, Item):
                    self.last_loot=res; self.loot_timer=180
                    lclick=False

            if not self.active_npc:
                for npc in self.current_map.npcs:
                    if p.rect.colliderect(npc.rect.inflate(30,30)):
                        if lclick and not shop_consumed:
                            npc.interact(); self.active_npc=npc; lclick=False
                        break

            if not self.shop.open and not (self.active_npc and self.active_npc.talking):
                if lclick:   self.try_attack(AttackType.SLASH, mouse_pos)
                if rclick:   self.try_attack(AttackType.LUNGE, mouse_pos)
                if q_dn:     self.try_attack(AttackType.SPIN,  mouse_pos)

            for k in self.cooldowns:
                if self.cooldowns[k]>0: self.cooldowns[k]-=1

            if self.attack:
                self._process_attack()
                self.attack.update()
                if not self.attack.active: self.attack=None

            for enemy in self.current_map.enemies:
                enemy.move_toward(p.rect)
                if enemy.rect.colliderect(p.rect): p.take_damage(enemy.damage)

            for portal in self.current_map.portals:
                if p.rect.colliderect(portal.rect):
                    self.current_map=self.maps[portal.destination]
                    p.rect.x=portal.spawn_x; p.rect.y=portal.spawn_y
                    if not self.current_map.enemies:
                        self.current_map.enemies=self._spawn_wave()
                    self.notify(f"Entered {self.current_map.name}!",90)
                    self.active_npc=None
                    break

            if not self.current_map.enemies:
                self.wave+=1
                self.current_map.enemies=self._spawn_wave()
                self.notify(f"Wave {self.wave}!",90)

            if p.is_dead(): self.state=GS.DEAD

            for t in self.damage_texts[:]:
                t.update()
                if t.life<=0: self.damage_texts.remove(t)

            # ── Draw ──────────────────────────────────────────────────────────
            self.current_map.draw(screen)
            self.shop.draw_world(screen)
            self.chest.draw(screen)
            self._draw_player()

            if self.attack: self.attack.draw(screen)

            for t in self.damage_texts: t.draw(screen)

            if self.active_npc: self.active_npc.draw_dialogue(screen, mouse_pos)
            self.shop.draw_panel(screen, p, mouse_pos)

            self._draw_hud(mouse_pos)
            self._draw_notifications()
            self._draw_loot()
            self._draw_minimap()

            pygame.display.flip()

        pygame.quit()

if __name__=="__main__":
    Game().run()
