    def _spawn_wave(self):
        if self.wave % 5 == 0:
            return [Enemy(self.wave, boss=True)]
        return [Enemy(self.wave) for _ in range(5+self.wave)]

    def save(self):
        with open(SAVE_FILE,"w") as f:
            json.dump({"player":self.player.to_dict(),"wave":self.wave,
                       "quest":{"goal":self.quest.goal,"progress":self.quest.progress,
                                "reward":self.quest.reward_gold}},f)
        self.notify("Game Saved!",120)

    def load(self):
        if not os.path.exists(SAVE_FILE): self.notify("No save.",90); return
        d=json.load(open(SAVE_FILE))
        self.player.from_dict(d["player"]); self.wave=d.get("wave",1)
        q=d.get("quest",{})
        self.quest.goal=q.get("goal",10); self.quest.progress=q.get("progress",0)
        self.quest.reward_gold=q.get("reward",100)
        self.notify("Loaded!",120)

    def notify(self, text, ttl=90): self.notifications.append((text,ttl))

    def try_attack(self, kind, mouse_pos):
        if self.cooldowns[kind] > 0 or self.player.rolling or self.shop.open: return
        if self.shop.rect.collidepoint(mouse_pos) or self.chest.rect.collidepoint(mouse_pos): return
        self.attack = Attack(kind, self.player.rect.center, mouse_pos, self.player.damage)
        self.cooldowns[kind] = Attack.COOLDOWNS[kind]

    def _process_attack(self):
        if not self.attack or not self.attack.active: return
        p = self.player
        for enemy in self.current_map.enemies[:]:
            if self.attack.hits(enemy.rect, id(enemy)):
                self.attack.hit_enemies.add(id(enemy))
                dmg = self.attack.damage
                enemy.hp -= dmg
                enemy.apply_knockback(self.attack.cx, self.attack.cy, self.attack.knockback)
                self.damage_texts.append(DamageText(str(dmg), enemy.rect.x, enemy.rect.y-10,
                    {AttackType.SLASH:(255,220,50),
                     AttackType.SPIN: (100,255,120),
                     AttackType.LUNGE:(255,120,80)}[self.attack.kind]))
                if enemy.hp <= 0:
                    self.current_map.enemies.remove(enemy)
                    p.gold += enemy.gold_reward
                    if p.add_xp(enemy.xp_reward): self.notify(f"Level Up! Lv.{p.level}",120)
                    if self.quest.advance():
                        p.gold += self.quest.reward_gold
                        self.notify(f"Quest done! +{self.quest.reward_gold}g",150)
                        self.quest = Quest("Kill Enemies",
                                           goal=self.quest.goal+5,
                                           reward_gold=self.quest.reward_gold+25)

