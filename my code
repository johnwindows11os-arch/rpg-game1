class Enemy:
    def __init__(self, wave: int, boss=False):
        size = 60 if boss else 24
        self.rect = pygame.Rect(random.randint(0,WIDTH-size), random.randint(HUD_TOP,HEIGHT-size), size, size)
        self.boss = boss
        self.max_hp = (300+wave*30) if boss else (15+wave*4)
        self.hp = self.max_hp
        self.speed = 1.2 if boss else 1.7
        self.xp_reward   = 25 if boss else 5
        self.gold_reward = 25 if boss else 5
        self.damage      = 0.4 if boss else 0.1
        self.kb_dx = 0.0; self.kb_dy = 0.0; self.kb_timer = 0

    def apply_knockback(self, from_cx, from_cy, magnitude):
        dx = self.rect.centerx - from_cx; dy = self.rect.centery - from_cy
        d = max(1, math.hypot(dx,dy))
        self.kb_dx = dx/d * magnitude; self.kb_dy = dy/d * magnitude
        self.kb_timer = 8

    def move_toward(self, target: pygame.Rect):
        if self.kb_timer > 0:
            self.rect.x += int(self.kb_dx); self.rect.y += int(self.kb_dy)
            self.kb_dx *= 0.75; self.kb_dy *= 0.75
            self.kb_timer -= 1
        else:
            dx = target.centerx-self.rect.centerx; dy = target.centery-self.rect.centery
            d = max(1,math.hypot(dx,dy))
            self.rect.x += int(dx/d*self.speed); self.rect.y += int(dy/d*self.speed)
        self.rect.clamp_ip(pygame.Rect(0,HUD_TOP,WIDTH,HEIGHT-HUD_TOP))

    def draw(self, surface):
        col = (255,70,70) if self.boss else (70,255,70)
        pygame.draw.rect(surface, col, self.rect)
        bar_w = int(self.rect.w*(self.hp/self.max_hp))
        pygame.draw.rect(surface,(255,0,0),(self.rect.x,self.rect.y-6,bar_w,4))

