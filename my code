    def _handle_inventory_clicks(self, mouse_pos):
        p = self.player
        pane = pygame.Rect(WIDTH//2-300, HEIGHT//2-200, 600, 400)
        
        # Check explicit Equipment Item slots removal
        slots = ["weapon", "armor", "accessory"]
        for idx, slot_type in enumerate(slots):
            slot_rect = pygame.Rect(pane.x+20, pane.y+70+idx*85, 180, 65)
            if p.equipment[slot_type]:
                un_btn = pygame.Rect(slot_rect.right-55, slot_rect.y+35, 50, 22)
                if un_btn.collidepoint(mouse_pos):
                    if p.unequip_item(slot_type): self.notify(f"Unequipped {slot_type}!", 90)
                    else: self.notify("Inventory full!", 90)
                    return

        # Check Grid Slot Matrix positions
        start_x, start_y = pane.x+230, pane.y+70
        slot_sz, pad = 55, 10
        cols = 5
        
        for i in range(p.max_inventory_slots):
            c = i % cols
            r = i // cols
            bx = start_x + c * (slot_sz + pad)
            by = start_y + r * (slot_sz + pad)
            if pygame.Rect(bx, by, slot_sz, slot_sz).collidepoint(mouse_pos):
                if i < len(p.inventory):
                    self.selected_inv_idx = i
                else:
                    self.selected_inv_idx = -1
                return

        # Check Context Action prompt sub-rect components
        if self.selected_inv_idx != -1 and self.selected_inv_idx < len(p.inventory):
            sel_item = p.inventory[self.selected_inv_idx]
            act_box = pygame.Rect(pane.x+230, pane.bottom-55, 350, 45)
            
            btn_eq = pygame.Rect(act_box.x+10, act_box.y+10, 75, 26)
            btn_sell = pygame.Rect(act_box.x+95, act_box.y+10, 75, 26)
            btn_drop = pygame.Rect(act_box.x+180, act_box.y+10, 75, 26)
            
            if btn_eq.collidepoint(mouse_pos):
                if sel_item.item_type == "potion":
                    p.hp = min(p.max_hp, p.hp + sel_item.stat_mod)
                    self.notify(f"Healed for {sel_item.stat_mod} HP!", 90)
                    p.inventory.remove(sel_item)
                else:
                    p.equip_item(sel_item)
                    self.notify(f"Equipped {sel_item.name}!", 90)
                self.selected_inv_idx = -1
            elif btn_sell.collidepoint(mouse_pos):
                p.gold += (sel_item.value // 2)
                self.notify(f"Sold for {sel_item.value//2}g!", 90)
                p.inventory.remove(sel_item)
                self.selected_inv_idx = -1
            elif btn_drop.collidepoint(mouse_pos):
                self.notify(f"Dropped {sel_item.name}!", 90)
                p.inventory.remove(sel_item)
                self.selected_inv_idx = -1

