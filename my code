class Map:
    BG    = {"Town":(60,100,60),"Forest":(20,70,20),"Dungeon":(30,20,40)}
    GRID  = {"Town":(70,120,70),"Forest":(25,85,25),"Dungeon":(40,28,55)}

    def __init__(self, name):
        self.name=name; self.portals=[]; self.npcs=[]; self.enemies=[]
        self.bg=self.BG.get(name,(35,90,35)); self.grid=self.GRID.get(name,(45,110,45))

    def draw(self, s):
        s.fill(self.bg)
        pygame.draw.rect(s,(10,10,10),(0,0,WIDTH,HUD_TOP))
        for x in range(0,WIDTH,32): pygame.draw.line(s,self.grid,(x,HUD_TOP),(x,HEIGHT))
        for y in range(HUD_TOP,HEIGHT,32): pygame.draw.line(s,self.grid,(0,y),(WIDTH,y))
        for p in self.portals: p.draw(s)
        for n in self.npcs:    n.draw(s)
        for e in self.enemies: e.draw(s)

